# Plantilla del .env del BACKEND. Copiar a backend/.env y llenar los valores.
# El .env real NUNCA se sube a git (está en .gitignore). En producción usar valores NUEVOS.
# Generar secretos aleatorios con: openssl rand -hex 32

# --- Base de datos ---
# En Docker el host es el nombre del servicio (db) y el puerto interno 3306
DB_HOST=db
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# Igual que DB_NAME del .env de la raíz
DB_NAME=
# Opcionales: tamaño del pool de conexiones (por defecto 20 y 20)
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20

# --- Seguridad (obligatorios, mínimo 32 caracteres; la API no arranca sin ellos) ---
# Firma de la cookie de sesión (JWT)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Firma de los códigos de verificación de correo
CODIGO_SECRET=

# --- Entorno ---
# "production" en el servidor: cookies seguras (HTTPS) y sin /docs.
# En producción docker-compose.prod.yml ya la fija; aquí puede quedar vacía.
ENVIRONMENT=
# Orígenes permitidos por CORS, separados por coma (ej.: https://midominio.com).
# En producción docker-compose.prod.yml la arma con DOMINIO.
ALLOWED_ORIGINS=
# Máximo de intentos de login por IP por minuto (por defecto 20; 0 lo desactiva)
# LOGIN_LIMITE_POR_IP=20
# Nivel de logs del backend: DEBUG, INFO, WARNING, ERROR (por defecto INFO)
# LOG_LEVEL=INFO

# --- Archivos (fotos y documentos) ---
# "local" = disco (desarrollo, por defecto). "s3" = bucket privado (producción: docker-compose.prod.yml lo fija).
# Con s3 las credenciales salen del rol de la máquina virtual en AWS: NO poner claves de AWS aquí.
# ALMACENAMIENTO=local
# S3_BUCKET_ARCHIVOS=
# AWS_REGION=us-east-2

# --- Correo (Mailjet) ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=
MAILJET_SENDER_NAME=

# --- Login con Google (ID público del cliente OAuth) ---
GOOGLE_CLIENT_ID=

# --- Panel admin: botón de logs. En producción docker-compose.prod.yml la arma con DOMINIO ---
GRAFANA_URL=

# --- IA de compatibilidad (Groq) ---
GROQ_API_KEY=

# --- Primer administrador: se crea al arrancar si el correo no existe; nunca cambia uno existente ---
# Contraseña: 8-64 caracteres, con mayúscula, minúscula y número
ADMIN_CORREO=
ADMIN_CONTRASENA=
ADMIN_NOMBRE=
