# Python
venv/
.venv/
__pycache__/
*.pyc

# Variables de entorno (contienen contraseñas)
.env
.env.*
!.env.example

# Fotos subidas por los usuarios: se generan al usar la app.
# Se conserva la estructura de carpetas con .gitkeep.
uploads/**
!uploads/
!uploads/*/
!uploads/**/.gitkeep

# Documentos de respaldo de los caballos (pedigrí, premios...): privados, nunca a git
documentos/

# Editor
.vscode/
.idea/

# Sistema
.DS_Store
Thumbs.db

# Copias de seguridad locales
backups/
*.bak

# Archivos temporales de SonarQube
.scannerwork/
report-task.txt

# Reportes de cobertura (se regeneran con pytest --cov)
.coverage
coverage.xml
htmlcov/
.pytest_cache/
